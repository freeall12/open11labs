# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local env / secrets
.env
.env.*
!.env.example

# Editor & OS
.DS_Store
.idea/
.vscode/
*.swp

# AppleDouble resource forks (created on exFAT/external volumes)
._*

# Tooling caches from other agents in this workspace
.v2c/
.video_agent/
.vite/
.zcodeignore

# Captured reference corpus from the live site (47MB).
# Excluded because it contains rendered account identifiers (gmail addresses
# appear in the text dumps and in the profile-menu screenshots) plus verbatim
# DOM snapshots of elevenlabs.io. Keep it local; do not publish it.
research/

# BYOK runtime data and generated test artifacts (never publish secrets)
data/
coverage/
test-results/
playwright-report/
*.log

# Keep other research-capture tooling ignored; these two safe helpers are public.
scripts/
!scripts/
scripts/*
!scripts/check-docs.mjs
!scripts/index-research.mjs

# Icon-library bundles (~1.3MB of the source site's own minified JS).
# Re-download with `node tools/fetch-bundles.mjs`; never commit them.
tools/icons-bundle.js
tools/nav-bundle.js
tools/.pull.json
tools/.icons.json


# Private runtime data (vault, assets, db, exports). Never commit.
data/
