# Local server
PORT=5173

# Optional. Without this the key vault is memory-only and keys are lost on
# restart. With it, keys are encrypted at rest under AES-256-GCM using a key
# derived via scrypt. The passphrase is NOT stored next to the ciphertext —
# lose it and the stored keys cannot be recovered.
# EL_MASTER_PASSWORD=

# Never put a provider key here. Provider keys are entered through the local
# settings page and are only ever read by the server process.
